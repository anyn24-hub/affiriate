# ============================================================
# @kessan_class 自動投稿パイプライン 環境変数設定
# このファイルを .env にコピーして値を入力してください
# cp .env.example .env
# ============================================================

# Claude API キー (https://console.anthropic.com/ で取得)
# Gemini API キー（無料）: https://aistudio.google.com/apikey で取得
# Groq API キー（完全無料）: https://console.groq.com/ で取得
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Drive フォルダID（URLの末尾部分）
# 例: https://drive.google.com/drive/folders/18wtkPzESM12OZhe4e2YLQ5mT1HhBVGw0
#         → フォルダID: 18wtkPzESM12OZhe4e2YLQ5mT1HhBVGw0
DRIVE_FOLDER_ID=18wtkPzESM12OZhe4e2YLQ5mT1HhBVGw0

# Google Drive フォルダURL（コンテンツ生成プロンプトに渡す）
DRIVE_FOLDER_URL=https://drive.google.com/drive/u/1/folders/18wtkPzESM12OZhe4e2YLQ5mT1HhBVGw0

# Google サービスアカウント JSON（TDnet自動化を使う場合のみ）
# Google Cloud Console → IAM → サービスアカウント → キー作成（JSON）
# jq -c . service_account.json で1行化できます
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# 楽天アフィリエイト設定（自動でランダム書籍リンクを取得）
# RAKUTEN_APP_ID   : https://webservice.rakuten.co.jp/ で無料登録して取得
# RAKUTEN_AFFILIATE_ID: 楽天アフィリエイト管理画面 → ツール → アフィリエイトID（例: 1.1234567.0）
RAKUTEN_APP_ID=1234567890
RAKUTEN_AFFILIATE_ID=1.1234567.0
